# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================

# Para desarrollo local (SQLite):
# Dejar DATABASE_URL vacío o comentado
# El sistema usará automáticamente usuarios.db

# Para producción (PostgreSQL en Cloud SQL):
# DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_db

# Ejemplo Cloud SQL con Unix Socket:
# DATABASE_URL=postgresql://usuario:password@/nombre_db?host=/cloudsql/proyecto:region:instancia

# Ejemplo Cloud SQL con IP pública:
# DATABASE_URL=postgresql://usuario:password@IP_PUBLICA:5432/nombre_db

# ===========================================
# VARIABLES PARA CLOUD RUN
# ===========================================
# Estas se configuran en la consola de Cloud Run

# PORT=8080  # Cloud Run lo establece automáticamente
